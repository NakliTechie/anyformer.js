{
  "name": "anyformer",
  "version": "0.4.15",
  "description": "One call to run a model in a browser tab: anyformer reads the Hub repo, probes the browser, and picks the back end (transformers.js, LocalMind's WebGPU kernels, diskformer, kohra) that fits the model's format, architecture and your GPU budget.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SPEC.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "test:browser": "node test/browser/run.mjs",
    "pin": "node scripts/pin-sources.mjs"
  },
  "keywords": [
    "agent",
    "browser",
    "diffusion",
    "diskformer",
    "gguf",
    "inference",
    "llm",
    "localmind",
    "onnx",
    "transformers",
    "webgpu",
    "webmcp"
  ],
  "license": "MIT",
  "author": "Chirag Patnaik",
  "homepage": "https://github.com/NakliTechie/anyformer.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakliTechie/anyformer.js.git"
  },
  "bugs": {
    "url": "https://github.com/NakliTechie/anyformer.js/issues"
  }
}
